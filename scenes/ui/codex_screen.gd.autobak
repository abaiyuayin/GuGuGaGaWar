	save_edit_btn.pressed.connect(_on_save_edit_pressed)  ## 连接保存按钮
	DevMode.dev_mode_changed.connect(_on_dev_mode_toggled)  ## 监听弢�发��模式切�?
	UIButtonHelper.setup_button(tab_unit_btn)  ## 设置兵�?选项卡样�?
