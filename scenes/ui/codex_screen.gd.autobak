## F11 弢��?��发��模式后恢�?显示（与 DevMode 切换回调联动�?
func _apply_dev_tab_visibility() -> void:
	var on: bool = DevMode.enabled
	tab_artifact_btn.visible = on
	tab_order_btn.visible = on
	tab_event_btn.visible = on

## ============================================================
## #霢��?9：abay 秘技—��图鉴爱弥斯详情页顺序输�?a-b-a-y 弢��?��发��模�?## ============================================================
## 秘技码（小写�?
const SECRET_CODE: String = "abay"
## 秘技输入缓冲（按顺序�?��，错丢��?��母从头重来）
var _secret_buffer: String = ""
## #15�?026-08-11）：G1 待机按钮连按秘技—��从爱弥�?���?abay 移�?�?## 图鉴详情页点 G1 待机按钮 7 次开�?��发��模式；3 秒未继续点击则重�??数��?
const G1_SECRET_TAPS: int = 7
const G1_TAP_RESET_MSEC: int = 3000
var _g1_idle_taps: int = 0
var _g1_idle_last_tap_msec: int = 0

## 图鉴�?��输入：仅在��兵�?+ G1（咕嘎勇�?��」�?情页生效
## 依�?�?a �?b �?a �?y 四键（不区分大小写），全部命�?��弢��?��发��模式；
## 其他页面或非字母�?��清空缓冲，避免�?触发
## #6�?026-08-11 用户拍板）：abay 秘技从爱弥斯（Hero1）页迁移�?G1 页，删除爱弥�?���?
func _unhandled_input(event: InputEvent) -> void:
	## �?G1 详情页生效（用户拍板�?
	if not (_selected_kind == "unit" and _selected_unit != null and _selected_unit.unit_id == "G1"):
		_secret_buffer = ""
		return
	if not (event is InputEventKey) or not event.pressed or event.echo:
		return
	## 仅接�?a/b/y �?��其他�?��空缓冲）

	var ch: String = ""
	match (event as InputEventKey).keycode:
		KEY_A: ch = "a"
		KEY_B: ch = "b"
		KEY_Y: ch = "y"
		_:
			_secret_buffer = ""
			return
	## 与�?抢�码当前位�?���?
	var expect: String = SECRET_CODE.substr(_secret_buffer.length(), 1)
	if ch == expect:
		_secret_buffer += ch
		if _secret_buffer == SECRET_CODE:
			_secret_buffer = ""
			_on_secret_entered()
	else:
		_secret_buffer = ""

## abay / G1 待机连按秘技命中：开�?��发��模式（F11 弢�关仍保留�?
func _on_secret_entered() -> void:
	if not DevMode.enabled:
		DevMode.set_enabled(true)
		## #Bug3��2026-08-12����������ģʽ������ˢ��ͼ���б�����������������Ŀ
		_build_list_for(_selected_kind)
		_update_unit_button_texts()

	var dlg := AcceptDialog.new()
	dlg.title = tr("TIP_TITLE")
	dlg.dialog_text = tr("DEV_MODE_ENABLED")
	dlg.ok_button_text = tr("CONFIRM")
	dlg.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(dlg)
	dlg.popup_centered()

func _apply_localization() -> void:  ## 应用�?��化文�?
	title_label.text = tr("CODEX_TITLE")  ## 设置标�?
	back_btn.text = tr("BACK")  ## 设置返回按钮
	idle_btn.text = tr("CODEX_IDLE")  ## 设置待机按钮
	walk_btn.text = tr("CODEX_WALK")  ## 设置行走按钮
	run_btn.text = tr("CODEX_RUN")  ## 设置奔跑按钮
	attack_btn.text = tr("CODEX_ATTACK")  ## 设置攻击按钮
	intro_header.text = tr("UNIT_INTRO")  ## 设置介绍标�?
	tips_header.text = tr("CODEX_AUTHOR_TIPS")  ## 设置作��Tips标�?
	stats_header.text = tr("CODEX_ROLE_STATS")  ## 角色数��标�?
	no_anim_label.text = tr("CODEX_NO_ANIM")  ## 设置无动画提�?
	match _selected_kind:  ## 根据当前选中的类型刷新�?情显�?
		"artifact":
			if _selected_artifact != null:
				_select_artifact(_selected_artifact)
		"order":
			if _selected_order != null:
				_select_order(_selected_order)
		"event":
			if _selected_event != null:
				_select_event(_selected_event)
		_:
			if _selected_unit != null:
				_select_unit(_selected_unit)
			else:
				_update_detail_placeholder()
	tab_unit_btn.text = tr("CODEX_TAB_UNIT")  ## 兵�?选项卡文�?
	tab_artifact_btn.text = tr("CODEX_TAB_ARTIFACT")  ## 文物选项卡文�?
	tab_order_btn.text = tr("CODEX_TAB_ORDER")  ## 军令选项卡文�?
	tab_event_btn.text = tr("CODEX_TAB_EVENT")  ## 事件选项卡文�?
	_highlight_tab_buttons()  ## 刷新选项卡高�?
	_update_unit_button_texts()  ## 更新兵�?按钮文本

func _setup_style() -> void:  ## 设置面板样式
	var panel_style = StyleBoxFlat.new()  ## 创建扁平样式�?
	panel_style.bg_color = Color(0.12, 0.12, 0.15, 0.95)  ## 深灰半��明背景
	panel_style.border_color = Color(0.3, 0.3, 0.35, 0.8)  ## 边�?�?
	panel_style.set_border_width_all(1)  ## 边�?宽度
	panel_style.set_corner_radius_all(6)  ## 圆�?
	## 预�?面板使用稍深的背�?
	var preview_style = StyleBoxFlat.new()  ## 创建预�?面板样式
	preview_style.bg_color = Color(0.06, 0.06, 0.08, 1)  ## 更深的背�?
	preview_style.border_color = Color(0.25, 0.25, 0.3, 0.6)  ## 边�?
	preview_style.set_border_width_all(1)  ## 边�?宽度
	preview_style.set_corner_radius_all(4)  ## 圆�?
	preview_panel.add_theme_stylebox_override("panel", preview_style)  ## 应用样式
	## 三个列表面板与右侧�?情面板共用同丢�套面板样�?
	var content_path := "MarginContainer/VBoxContainer/Content"
	get_node("%s/ListPanel" % content_path).add_theme_stylebox_override("panel", panel_style)  ## 列表面板
	get_node("%s/RightPanel" % content_path).add_theme_stylebox_override("panel", panel_style)  ## 右侧详情面板

## 根据兵�? ID 前缀获取阵营标识
func _get_faction_prefix(unit_id: String) -> String:  ## 获取阵营前缀
	return unit_id[0]  ## 取�?字母作为阵营前缀

## 从兵�?ID 提取数字部分用于排序（G1�?, D6�?�?
func _get_unit_number(unit_id: String) -> int:  ## 获取兵�?编号
	var num_str: String = unit_id.substr(1)  ## 去掉前缀字母
	if num_str.is_valid_int():  ## 如果�?��效整�?
		return int(num_str)  ## 返回数字
	return 0  ## 无效则返�?

## 按阵营分组构建兵种列�?��阵营内按编号 1-6 排序
## 根据分类构建对应的列表到共享容器（兵�?文物/军令共用丢��?��表面板）
func _build_list_for(kind: String) -> void:  ## 构建指定分类列表
	for child in list_container.get_children():  ## 清理容器
		child.queue_free()
	match kind:  ## 按分类分�?
		"unit": _build_unit_buttons(list_container)  ## 兵�?
		"artifact": _build_artifact_buttons(list_container)  ## 文物
		"order": _build_order_buttons(list_container)  ## 军令
		"event": _build_event_buttons(list_container)  ## 宝�?事件

## 按阵营分组构建兵种列�?��阵营内按编号 1-6 排序
func _build_unit_buttons(container: VBoxContainer) -> void:  ## 构建兵种列表
	_unit_buttons.clear()  ## 清空按钮数组
	## 按阵营前缀分组（常规兵种 + 特殊英雄单位，后者归入第 5 阵营「英雄」）
	var grouped: Dictionary = {}
	var all_units: Array = UnitDatabase.unit_list + UnitDatabase.special_units
	for res in all_units:  ## 遍历所有兵种
		var prefix: String = _get_faction_prefix(res.unit_id)  ## 获取阵营前缀
		if not grouped.has(prefix):  ## 如果该阵营尚未建立分组
			grouped[prefix] = []  ## 创建空数组
		grouped[prefix].append(res)  ## 添加到对应阵营
	## 按指定顺序（咕嘎、Doro、菲比、糯糯、英雄）遍历阵营
	for prefix in FACTION_ORDER:  ## 遍历阵营顺序
		if not grouped.has(prefix):  ## 如果该阵营没有兵种
			continue  ## 跳过该阵营
		grouped[prefix].sort_custom(
			func(a, b): return _get_unit_number(a.unit_id) < _get_unit_number(b.unit_id))  ## 按编号升序
		## 添加阵营标签
		var faction_label = Label.new()  ## 创建阵营标签
		var is_special: bool = (prefix == "H")  ## 英雄阵营为特殊
		if is_special:
			faction_label.text = tr("CODEX_HERO_SPECIAL")  ## 特殊英雄直接显示，不走翻译键
		else:
			var faction_key: String = FACTION_NAME_KEYS.get(prefix, "")  ## 获取阵营名翻译键
			faction_label.text = tr(faction_key)  ## 设置阵营名
		faction_label.add_theme_font_size_override("font_size", 16)  ## 字体大小
		if is_special:
			## 特殊行：明亮青金色，区别于常规金色
			faction_label.add_theme_color_override("font_color", Color(0.4, 1.0, 0.9))  ## 青绿色
		else:
			faction_label.add_theme_color_override("font_color", Color(1, 0.85, 0.4))  ## 金黄色
		faction_label.custom_minimum_size = Vector2(0, 30)  ## 最小高度
		faction_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER  ## 垂直居中
		container.add_child(faction_label)  ## 添加到列表
		## 添加该阵营下的兵种按钮
		for res in grouped[prefix]:  ## 遍历该阵营的兵种
			var btn = Button.new()  ## 创建按钮
			btn.custom_minimum_size = Vector2(0, 44)  ## 最小高度
			btn.text = res.get_display_name()  ## 设置兵种名
			btn.alignment = HORIZONTAL_ALIGNMENT_LEFT  ## 左对齐
			btn.focus_mode = Control.FOCUS_NONE  ## 禁用焦点
			UIButtonHelper.setup_button(btn)  ## 设置按钮样式
			btn.set_meta("sel_kind", "unit")  ## 标记选中类型
			btn.set_meta("sel_id", res.unit_id)  ## 标记选中 ID
			btn.set_meta("unit_resource", res)  ## 存储兵种资源
			btn.pressed.connect(_on_unit_button_pressed.bind(res))  ## 连接信号
			container.add_child(btn)  ## 添加到列表
			_unit_buttons.append(btn)  ## 添加到数组
		## #14：构建时按解锁状态刷新按钮（锁定加 🔒 前缀并置灰，逻辑见 _update_unit_button_texts）
	_update_unit_button_texts()
func _build_artifact_buttons(container: VBoxContainer) -> void:  ## 构建artifact列表
	_artifact_buttons.clear()  ## 清空按钮数组
	if ItemDatabase.artifact_list.is_empty():  ## 无artifact数据
		return  ## 仅留空位
	for x in ItemDatabase.artifact_list:  ## 遍历artifact
		var btn := _make_item_button(art.display_name, art.get_rarity_color())  ## 创建按钮
		btn.set_meta("sel_kind", "artifact")  ## 标记选中类型
		btn.set_meta("sel_id", art.artifact_id)  ## 标记选中 ID
		btn.pressed.connect(_on_artifact_button_pressed.bind(x))  ## 连接信号
		container.add_child(btn)  ## 添加
		_artifact_buttons.append(btn)  ## 记录
func _build_order_buttons(container: VBoxContainer) -> void:  ## 构建order列表
	_order_buttons.clear()  ## 清空按钮数组
	if ItemDatabase.order_list.is_empty():  ## 无order数据
		return  ## 仅留空位
	for x in ItemDatabase.order_list:  ## 遍历order
		var btn := _make_item_button(od.display_name, od.get_rarity_color())  ## 创建按钮
		btn.set_meta("sel_kind", "order")  ## 标记选中类型
		btn.set_meta("sel_id", od.order_id)  ## 标记选中 ID
		btn.pressed.connect(_on_order_button_pressed.bind(x))  ## 连接信号
		container.add_child(btn)  ## 添加
		_order_buttons.append(btn)  ## 记录
func _build_event_buttons(container: VBoxContainer) -> void:  ## 构建event列表
	_event_buttons.clear()  ## 清空按钮数组
	if ItemDatabase.chest_event_list.is_empty():  ## 无event数据
		return  ## 仅留空位
	for x in ItemDatabase.chest_event_list:  ## 遍历event
		var btn := _make_item_button(ev.title, Color(0.9, 0.8, 0.5, 1.0))  ## 创建按钮
		btn.set_meta("sel_kind", "event")  ## 标记选中类型
		btn.set_meta("sel_id", ev.event_id)  ## 标记选中 ID
		btn.pressed.connect(_on_event_button_pressed.bind(x))  ## 连接信号
		container.add_child(btn)  ## 添加
		_event_buttons.append(btn)  ## 记录
func _make_item_button(text: String, color: Color) -> Button:  ## 道具按钮
	var btn := Button.new()  ## 创建按钮
	btn.custom_minimum_size = Vector2(0, 40)  ## 朢�小高�?
	btn.text = text  ## 设置文本
	btn.alignment = HORIZONTAL_ALIGNMENT_LEFT  ## 左�?�?
	btn.focus_mode = Control.FOCUS_NONE  ## 禁用焦点
	UIButtonHelper.setup_button(btn)  ## 设置基�?样式
	btn.add_theme_color_override("font_color", color)  ## 按稀有度睢��?
	return btn  ## 返回按钮

func _update_unit_button_texts() -> void:  ## 更新按钮文本
	for btn in _unit_buttons:  ## 遍历所有按钮
		var res: UnitResource = btn.get_meta("unit_resource")  ## 获取兵种资源
		## #14：锁定兵种锁定显示 🔒 前缀 + 暗灰文字；已解锁正常显示
		## #5：锁定兵种点击不再显示详情（右侧占位），图鉴只读展示已解锁兵种
		var unlocked: bool = CampaignProgress.is_unit_unlocked(res.unit_id)
		btn.text = res.get_display_name() if unlocked else "🔒 " + res.get_display_name()
		btn.add_theme_color_override("font_color", Color(0.88, 0.88, 0.88, 1.0) if unlocked else Color(0.45, 0.45, 0.5, 1.0))
func _on_unit_button_pressed(res: UnitResource) -> void:  ## 兵�?按钮按下回调
	## #5�?026-08-11）：�?��锁兵种不�?��看�?细信�?����右侧锁定为占位提示
	if not CampaignProgress.is_unit_unlocked(res.unit_id):
		_show_locked_unit_placeholder(res)
		return
	_select_unit(res)  ## 选中该兵�?
## #5�?026-08-11）：锁定兵�?的右侧占位�����?用��用占位布局后�?盖提示文�?
func _show_locked_unit_placeholder(res: UnitResource) -> void:
	_update_detail_placeholder()
	name_label.text = tr("CODEX_LOCKED_UNIT") % res.get_display_name()  ## #Bug1��2026-08-12��������������ʾ�߱��ػ�

func _on_artifact_button_pressed(art: ArtifactData) -> void:  ## 文物按钮按下回调
	_select_artifact(art)  ## 选中该文�?
func _on_order_button_pressed(od: MilitaryOrderData) -> void:  ## 军令按钮按下回调
	_select_order(od)  ## 选中该军�?
func _on_event_button_pressed(ev: ChestEventData) -> void:  ## 事件按钮按下回调
	_select_event(ev)  ## 选中该事�?
func _on_idle_btn_pressed() -> void:  ## 待机按钮按下回调
	_current_anim_mode = "idle"  ## 切换到待机模式
	_play_preview_anim()  ## 播放预览动画
	## #15：G1 待机按钮连按 7 次秘技（从爱弥斯 abay 迁移）：仅在 G1 详情页生效
	## 3 秒未继续点击则重置计数，防止跨操作误触发
	if _selected_kind == "unit" and _selected_unit != null and _selected_unit.unit_id == "G1":
		var now: int = Time.get_ticks_msec()
		if now - _g1_idle_last_tap_msec > G1_TAP_RESET_MSEC:
			_g1_idle_taps = 0
		_g1_idle_last_tap_msec = now
		_g1_idle_taps += 1
		if _g1_idle_taps >= G1_SECRET_TAPS:
			_g1_idle_taps = 0
			_on_secret_entered()
func _on_walk_btn_pressed() -> void:  ## 行走按钮按下回调
	_current_anim_mode = "walk"  ## 切换到�?走模�?
	_play_preview_anim()  ## �?��预�?动画

func _on_run_btn_pressed() -> void:  ## 奔跑按钮按下回调
	_current_anim_mode = "move"  ## 切换到�?跑模�?
	_play_preview_anim()  ## �?��预�?动画

func _on_attack_btn_pressed() -> void:  ## 攻击按钮按下回调
	_current_anim_mode = "attack"  ## 切换到攻击模�?
	_play_preview_anim()  ## �?��预�?动画

## 选中指定兵�?，更新右侧�?情区
func _select_unit(res: UnitResource) -> void:  ## 选中兵�?
	_selected_kind = "unit"  ## 记录选中类型
	_selected_id = res.unit_id  ## 记录选中 ID
	_selected_unit = res  ## 保存选中资源
	_set_detail_mode(DetailType.UNIT)  ## 切换到兵种�?情布屢�
	name_label.text = res.get_display_name()  ## 更新名称（位于顶�?��
	desc_label.text = ItemDatabase.get_unit_description(res)  ## 介绍（支持开发���?盖文�?��
	var tips_key = "UNIT_%s_TIPS" % res.unit_id  ## 构��Tips翻译�?
	var tips_text = tr(tips_key)  ## 查�?翻译
	if tips_text == tips_key:  ## 如果翻译缺失
		tips_text = ""  ## 使用空文�?
	tips_label.text = tips_text  ## 设置Tips文本
	price_label.text = "%s: $%d" % [tr("CODEX_PRICE"), res.cost]  ## 显示价格
	_build_attributes_table(res)  ## 构建属��表�?
	_load_unit_animations(res)  ## 加载动画�?
	_play_preview_anim()  ## �?��预�?
	_highlight_active_list()  ## 高亮选中按钮
	_refresh_dev_edit()  ## 刷新弢�发��编辑区

## 选中指定文物，更新右侧�?情区
func _select_artifact(art: ArtifactData) -> void:  ## 选中文物
	_selected_kind = "artifact"  ## 记录选中类型
	_selected_id = art.artifact_id  ## 记录选中 ID
	_selected_artifact = art  ## 保存选中资源
	_set_detail_mode(DetailType.ARTIFACT)  ## 切换到文物�?情布屢�
	name_label.text = art.display_name  ## 名称
	rarity_label.text = "稀有度：" + art.get_rarity_name()  ## 稢�有度
	rarity_label.modulate = art.get_rarity_color()  ## 稢�有度配色
	price_label.text = "�?���?%d" % art.cost  ## �?��
	appearance_label.text = art.appearance  ## 外�?描述
	desc_label.text = art.description  ## 效果说明
	tips_label.text = art.flavor  ## 风味文本
	effect_label.text = _format_effect(art.effect_type, art.effect_value)  ## 效果
	_highlight_active_list()  ## 高亮选中按钮
	_refresh_dev_edit()  ## 刷新弢�发��编辑区

## 选中指定军令，更新右侧�?情区
func _select_order(od: MilitaryOrderData) -> void:  ## 选中军令
	_selected_kind = "order"  ## 记录选中类型
