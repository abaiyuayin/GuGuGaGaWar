	_switch_tab("unit")  ## 默�?显示兵�?选项卡并选中�?���?	## #新需求：文物/军令/事件图鉴仅开发��模式可见����按当前 DevMode 初�?�?Tab 显隐
	_apply_dev_tab_visibility()

