	rarity_label.modulate = od.get_rarity_color()  ## 稢�有度配色
	price_label.text = "�?���?%d" % od.cost  ## �?��
	appearance_label.text = od.appearance  ## 外�?描述
	desc_label.text = od.description  ## 效果说明
	tips_label.text = od.flavor  ## 风味文本
